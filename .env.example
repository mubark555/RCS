# انسخ هذا الملف إلى .env.local واملأ القيم من مشروع Supabase الخاص بك
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ملاحظة: إذا تركت هذه القيم فارغة، يعمل النظام تلقائياً في وضع "الحفظ المحلي"
# (localStorage) للتجربة السريعة على جهاز واحد بدون قاعدة بيانات.

# ===================== إشعارات البريد الإلكتروني (خادم فقط) =====================
# اختر مزوّداً واحداً: Resend (الأسهل) أو SMTP (Gmail / Outlook / Zoho …)

# --- الخيار 1: Resend  (https://resend.com → API Keys) ---
RESEND_API_KEY=
# المرسل (يجب أن يكون نطاقه موثّقاً في Resend)
EMAIL_FROM="ڤيوليت <noreply@yourdomain.com>"

# --- الخيار 2: SMTP ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password      # في Gmail استخدم "كلمة مرور التطبيقات"

# بريد الرد (اختياري)
# EMAIL_REPLY_TO=pm@yourdomain.com

# رابط النظام المنشور (يظهر زر "فتح في النظام" داخل البريد)
APP_URL=https://your-app.vercel.app
# المنطقة الزمنية لعرض المواعيد في البريد
APP_TIMEZONE=Asia/Riyadh

# مفتاح سري لحماية رابط التذكيرات المجدولة /api/cron/reminders
CRON_SECRET=
# مفتاح service_role من Supabase (Project Settings → API) — إلزامي في الوضع السحابي.
# الخادم وحده يستخدمه للوصول لقاعدة البيانات بعد التحقق من الصلاحيات. لا تضع له بادئة NEXT_PUBLIC أبداً.
SUPABASE_SERVICE_ROLE_KEY=

# ===================== تسجيل الدخول برمز OTP =====================
# ضبط هذا المتغير يفعّل الدخول الإلزامي برمز يُرسل للبريد (يحتاج إعداد البريد أعلاه)
# أنشئ قيمة عشوائية طويلة، مثلاً:  openssl rand -base64 32
AUTH_SECRET=
# بريد مدير/مدراء يُسمح لهم دائماً بالدخول كمدير (للبدء قبل إضافة البريد في صفحة الفريق)
AUTH_ADMIN_EMAILS=
# مدة بقاء الجلسة بالساعات (الافتراضي 168 = 7 أيام)
# AUTH_SESSION_HOURS=168
