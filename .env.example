# انسخ هذا الملف إلى .env.local واملأ القيم من مشروع Supabase الخاص بك
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ملاحظة: إذا تركت هذه القيم فارغة، يعمل النظام تلقائياً في وضع "الحفظ المحلي"
# (localStorage) للتجربة السريعة على جهاز واحد بدون قاعدة بيانات.

# صوت «أمل» (اختياري): يعمل بصوت عصبي مجاني بلا مفتاح. لضمان ثبات الخدمة اربط Azure Speech
# (الطبقة المجانية تكفي: 500 ألف حرف شهرياً) — Azure Portal > Speech service > Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# الصوت الافتراضي ar-SA-ZariyahNeural (سعودي نسائي). بدائل: ar-AE-FatimaNeural, ar-KW-NouraNeural, ar-QA-AmalNeural
TTS_VOICE=
